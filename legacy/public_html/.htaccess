<IfModule mod_rewrite.c>
	Options +FollowSymLinks
	RewriteEngine On
	RewriteBase /
	
	#force SSL site wide
	RewriteCond %{HTTP_HOST} ^(www\.matthewemery\.com\.au)$ [NC]
	RewriteCond %{SERVER_PORT} 80 
	RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

	
	#Rewrite "example.com -> www.example.com" http://stackoverflow.com/a/4958847/2617158
	RewriteCond %{HTTP_HOST} !^$
	RewriteCond %{HTTP_HOST} ^(matthewemery\.com\.au)$ [NC]
	RewriteCond %{HTTPS}s ^on(s)|
	RewriteRule ^ http%1://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

</IfModule>